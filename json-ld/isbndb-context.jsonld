    },
    "price": {
      "@id": "schema:price"
    },
    "total": {
      "@id": "isbndb:totalPrice"
    },
    "shipping": {
      "@id": "schema:shippingRate"
    },
    "link": {
      "@id": "schema:url",
      "@type": "@id"
    },
    "total_results": {
      "@id": "schema:numberOfItems",
      "@type": "schema:Integer"
    },
    "page": {
      "@id": "isbndb:page",
      "@type": "schema:Integer"
    },
    "page_size": {
      "@id": "isbndb:pageSize",
      "@type": "schema:Integer"
    }
  }

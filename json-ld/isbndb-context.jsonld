{
  "@context": {
    "@vocab": "https://schema.org/",
    "isbndb": "https://isbndb.com/api/v2/",
    "isbn13": {
      "@id": "schema:isbn",
      "@type": "@id"
    },
    "isbn10": {
      "@id": "schema:isbn"
    },
